<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; margin: 0; padding: 20px; }
    .card { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 10px; padding: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    .header { border-bottom: 2px solid #e9edf7; padding-bottom: 15px; }
    .status-APPROVED { color: #38a169; }
    .status-REJECTED { color: #e53e3e; }
    .badge-status { display: inline-block; padding: 6px 16px; border-radius: 20px; font-weight: bold; font-size: 14px; text-transform: uppercase; }
    .APPROVED { background-color: #c6f6d5; color: #22543d; }
    .REJECTED { background-color: #fed7d7; color: #742a2a; }
    .ticket-table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    .ticket-table td { padding: 10px; border-bottom: 1px solid #edf2f7; }
    .footer { text-align: center; color: #a310b5; font-size: 12px; margin-top: 25px; }
  </style>
</head>
<body>
  <div class="card">
    <h2 class="header status-<%= status %>">Request Status Update: <span class="badge-status <%= status %>"><%= status %></span></h2>
    <p>The request "<strong><%= title %></strong>" status has been updated:</p>
    <table class="ticket-table">
      <tr><td><strong>Title:</strong></td><td><%= title %></td></tr>
      <tr><td><strong>Status:</strong></td><td><span class="badge-status <%= status %>"><%= status %></span></td></tr>
      <tr><td><strong>Type:</strong></td><td><%= type %></td></tr>
      <tr><td><strong>Requester:</strong></td><td><%= requesterEmail %></td></tr>
      <tr><td><strong>Superior:</strong></td><td><%= superiorEmail %></td></tr>
    </table>
    <div class="footer">
      &copy; Microservices Request Platform | Automated Notification
    </div>
  </div>
</body>
</html>
