<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; margin: 0; padding: 20px; }
    .card { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 10px; padding: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    .header { color: #4318ff; border-bottom: 2px solid #e9edf7; padding-bottom: 15px; }
    .badge-urgency { display: inline-block; padding: 4px 12px; border-radius: 20px; font-weight: bold; font-size: 12px; }
    .High { background-color: #ffe5e5; color: #e53e3e; }
    .Medium { background-color: #fffaf0; color: #dd6b20; }
    .Low { background-color: #e6fffa; color: #319795; }
    .ticket-table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    .ticket-table td { padding: 10px; border-bottom: 1px solid #edf2f7; }
    .footer { text-align: center; color: #a310b5; font-size: 12px; margin-top: 25px; }
  </style>
</head>
<body>
  <div class="card">
    <h2 class="header">📋 New Request Created</h2>
    <p>A new request requires attention:</p>
    <table class="ticket-table">
      <tr><td><strong>Title:</strong></td><td><%= title %></td></tr>
      <tr><td><strong>Description:</strong></td><td><%= description %></td></tr>
      <tr><td><strong>Type:</strong></td><td><%= type %></td></tr>
      <tr><td><strong>Urgency:</strong></td><td><span class="badge-urgency <%= urgency %>"><%= urgency %></span></td></tr>
      <tr><td><strong>Requester:</strong></td><td><%= requesterEmail %></td></tr>
      <tr><td><strong>Superior:</strong></td><td><%= superiorEmail %></td></tr>
    </table>
    <div class="footer">
      &copy; Microservices Request Platform | Action Required
    </div>
  </div>
</body>
</html>
