# Application Settings
APP_NAME=request-service
PORT=8003
DEBUG=True

# Database (MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=request_db

# Security & JWT (Must match auth-service JWT_SECRET_KEY to verify tokens)
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256

# Microservices Communication
NOTIFICATION_SERVICE_URL=http://localhost:8002
